  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#8a8377", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "constant.other.symbol"],
      "settings": { "foreground": "#6b5840" }
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#a86d23" }
    },
    {
      "name": "Number / Boolean / Constant",
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#a86d23" }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#8c6520" }
    },
    {
      "name": "Control flow",
      "scope": ["keyword.control"],
      "settings": { "foreground": "#8c6520", "fontStyle": "italic" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator", "punctuation"],
      "settings": { "foreground": "#8a8377" }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#2a2620" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": { "foreground": "#2a2620" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "meta.definition.variable.name"],
      "settings": { "foreground": "#5a5247" }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#5a5247", "fontStyle": "italic" }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "support.variable.property"],
      "settings": { "foreground": "#5a5247" }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#8c6520" }
    },
    {
      "name": "Tag attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#6b5840" }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#2a2620", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8c6520" }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#5a5247", "fontStyle": "italic" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#6b5840" }
    },
    {
      "name": "Diff added",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#5e7042" }
    },
    {
      "name": "Diff removed",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#a85e3a" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#a85e3a" }
    }
  ]
}
